{
  "html.validate.scripts": false,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.next": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/node_modules": true
  },
  "cSpell.ignorePaths": [
    "**/.next/**",
    "**/node_modules/**",
    "**/pnpm-lock.yaml",
    "**/package.json"
  ],
  "cSpell.words": [
    "mylove",
    "nimg",
    "playsinline",
    "clsx",
    "lucide",
    "glassmorphism",
    "confetti"
  ]
}
